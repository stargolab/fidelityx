DB_HOST=localhost
DB_PORT=3306
DB_NAME=fidelityx
DB_USER=
DB_PASS=

# endereco publico do sistema (usado no QR code do cartaz). Opcional: vazio usa o host da requisicao.
# Atras de proxy/load balancer, preencha, ex.: https://app.seudominio.com.br
APP_URL=

# fuso horario da aplicacao (nome IANA). Opcional: vazio usa America/Sao_Paulo.
APP_TIMEZONE=

# --- producao ---

# proxies confiaveis (ips ou faixas CIDR, separados por virgula). So preencha se houver proxy reverso ou
# load balancer na frente: o ip do cliente passa a vir do X-Forwarded-For e o https do X-Forwarded-Proto,
# mas apenas quando a requisicao chega de um destes enderecos. Vazio = usa sempre o ip da conexao.
# ex.: TRUSTED_PROXIES=127.0.0.1,172.16.0.0/12
TRUSTED_PROXIES=

# arquivo do log de erros. Opcional: vazio usa o destino do php.ini (no Docker, a saida do container).
LOG_FILE=

# backup do banco (php bin/backup.php): pasta de destino (vazio = storage/backups), dias guardados
# (vazio = 14; 0 = nunca apaga) e caminho do mysqldump se nao estiver no PATH
# (XAMPP: C:\xampp\mysql\bin\mysqldump.exe ja e encontrado sozinho).
BACKUP_DIR=
BACKUP_KEEP_DAYS=
MYSQLDUMP_BIN=

# e-mail transacional (recuperacao de senha, confirmacao de e-mail). Vazio = nenhum e-mail sai e o log avisa
# (o provedor de producao ainda nao foi escolhido). Em desenvolvimento use MAIL_DRIVER=log: cada e-mail vira uma
# linha json em MAIL_LOG_FILE (vazio = storage/mail.log), com os links. Nunca use "log" em producao.
MAIL_DRIVER=
MAIL_LOG_FILE=

# so para o docker compose: senha do root do MySQL do container e porta publicada no host (vazio = 8080).
# No compose, DB_PASS acima e a senha do usuario "fidelityx" do banco e nao pode ficar vazia.
DB_ROOT_PASS=
APP_PORT=
